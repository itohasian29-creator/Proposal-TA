    </div>

    <!-- JAVASCRIPT UNTUK FUNGSI SLIDER DAN AUTO-SCALE -->
    <script>
        const slides = document.querySelectorAll('.slide-container');
        const counter = document.getElementById('counter');
        let currentSlide = 0;

        function showSlide(index) {
            slides.forEach(slide => slide.classList.remove('active'));
            
            // Logika looping array (jika sudah di slide terakhir, balik ke awal)
            currentSlide = (index + slides.length) % slides.length;
            
            slides[currentSlide].classList.add('active');
            counter.innerText = `${currentSlide + 1} / ${slides.length}`;
        }

        function nextSlide() { showSlide(currentSlide + 1); }
        function prevSlide() { showSlide(currentSlide - 1); }

        // Fungsi agar slide bisa dipindah dengan tombol panah di Keyboard
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === ' ') {
                nextSlide();
            } else if (e.key === 'ArrowLeft') {
                prevSlide();
            }
        });

        // Fungsi Auto-Scale: Membuat ukuran presentasi menyesuaikan layar (responsif)
        function scalePresentation() {
            const area = document.getElementById('presentation-area');
            // Menghitung rasio zoom berdasarkan lebar dan tinggi layar (diberi sedikit margin)
            const scaleX = (window.innerWidth - 40) / 1100;
            const scaleY = (window.innerHeight - 40) / 650;
            const scale = Math.min(scaleX, scaleY, 1.2); // Batas maksimal zoom
            
            area.style.transform = `scale(${scale})`;
        }

        // Jalankan fungsi saat web dibuka & saat ukuran layar berubah
        window.addEventListener('resize', scalePresentation);
        scalePresentation();
        showSlide(0); // Tampilkan slide pertama
    </script>

</body>
